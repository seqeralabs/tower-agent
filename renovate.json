{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": ["gradle", "gradle-wrapper", "github-actions"],
  "schedule": ["after 10pm on sunday", "before 6am on monday"],
  "packageRules": [
    {
      "matchManagers": ["gradle", "gradle-wrapper"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "gradle minor and patch"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "github actions"
    },
    {
      "description": "setup-graalvm rejects java-jdk (Temurin) versions like 25.0.4+7.0.LTS; the GraalVM JDK is pinned for the native image (COMP-2583) and bumped by hand",
      "matchDepNames": ["java-jdk"],
      "enabled": false
    }
  ]
}
